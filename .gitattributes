# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.rs text diff=rust
*.toml text
*.md text
*.yml text
*.yaml text
*.json text
*.sh text eol=lf
*.ps1 text eol=crlf

# Build outputs
/target/ linguist-generated=true
Cargo.lock linguist-generated=true

# Documentation
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Archives
*.zip binary
*.tar.gz binary
*.tgz binary
*.rar binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary

# Templates
*.hbs text
*.handlebars text

# Database
*.db binary
*.sqlite binary
