{
  "name": "forge-vscode",
  "displayName": "Forge Build System",
  "description": "VS Code extension for Forge build orchestration system",
  "version": "0.1.0",
  "publisher": "requla11",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:forge.build",
    "onCommand:forge.test",
    "onCommand:forge.graph",
    "onCommand:forge.clean",
    "onCommand:forge.doctor",
    "onCommand:forge.affected",
    "onView:forgePackages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.build",
        "title": "Forge: Build Project"
      },
      {
        "command": "forge.test",
        "title": "Forge: Run Tests"
      },
      {
        "command": "forge.graph",
        "title": "Forge: Show Build Graph"
      },
      {
        "command": "forge.clean",
        "title": "Forge: Clean Build Artifacts"
      },
      {
        "command": "forge.doctor",
        "title": "Forge: Run Diagnostics"
      },
      {
        "command": "forge.affected",
        "title": "Forge: Show Affected Packages"
      },
      {
        "command": "forge.refreshPackages",
        "title": "Forge: Refresh Package Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "forge.buildPackage",
        "title": "Forge: Build Selected Package"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge-container",
          "title": "Forge",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "forge-container": [
        {
          "id": "forgePackages",
          "name": "Packages",
          "when": "workspaceHasFolder"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "rustc",
        "owner": "rustc",
        "source": "rustc",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(\\d+):(\\d+)\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 7,
          "severity": 6
        }
      },
      {
        "name": "rustc-simple",
        "owner": "rustc",
        "source": "rustc",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^(error|warning):\\s+(.*)$",
          "message": 2,
          "severity": 1
        }
      },
      {
        "name": "typescript",
        "owner": "typescript",
        "source": "typescript",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^(.*?)(\\(\\d+,\\d+\\)):\\s+(TS\\d+)\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "location": 2,
          "code": 3,
          "message": 5,
          "severity": 4
        }
      },
      {
        "name": "gcc",
        "owner": "gcc",
        "source": "gcc",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 5,
          "severity": 4
        }
      }
    ],
    "statusBarItems": [
      {
        "id": "forge.status",
        "name": "Forge Build Status",
        "alignment": "left",
        "priority": 100
      },
      {
        "id": "forge.cacheHitRate",
        "name": "Forge Cache Hit Rate",
        "alignment": "right",
        "priority": 90
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.path": {
          "type": "string",
          "default": "forge",
          "description": "Path to forge executable"
        },
        "forge.experimental": {
          "type": "boolean",
          "default": false,
          "description": "Enable experimental features"
        },
        "forge.maxJobs": {
          "type": "number",
          "default": 4,
          "description": "Maximum parallel jobs"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}