# Monorepo Pipeline Template
# Generated by Fish Templates

name: {{project_name}}-ci
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        package: {{#each packages}}[{{this}}]{{#unless @last}}, {{/unless}}{{/each}}
    steps:
      - uses: actions/checkout@v3
      - name: Install Fish
        run: curl -fsSL https://raw.githubusercontent.com/requla11/fish/main/scripts/install.sh | bash
      - name: Build {{this}}
        run: fish build -p {{this}}
