# Monorepo Pipeline Template
# Generated by Forge Templates

name: {{project_name}}-ci
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        package: {{#each packages}}[{{this}}]{{#unless @last}}, {{/unless}}{{/each}}
    steps:
      - uses: actions/checkout@v3
      - name: Install Forge
        run: curl -fsSL https://raw.githubusercontent.com/foursavage-dev/forge-rs/main/install.sh | bash
      - name: Build {{this}}
        run: forge build -p {{this}}
