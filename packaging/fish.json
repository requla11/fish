# Scoop manifest for Fish (Windows package manager).
# Install: scoop install https://raw.githubusercontent.com/requla11/fish/main/packaging/fish.json
# Update this file in the release pipeline when a new version ships.

{
    "version": "0.5.0",
    "description": "Fast, flexible, cache-first build orchestration system for Rust and beyond.",
    "homepage": "https://github.com/requla11/fish",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/requla11/fish/releases/download/v0.5.0/fish-0.5.0-x86_64-pc-windows-msvc.zip",
            "hash": "REPLACE_WITH_SHA256_AT_RELEASE"
        }
    },
    "bin": [
        ["fish-0.5.0-x86_64-pc-windows-msvc\\fish.exe", "fish"]
    ],
    "checkver": {
        "github": "https://github.com/requla11/fish"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/requla11/fish/releases/download/v$version/fish-$version-x86_64-pc-windows-msvc.zip"
            }
        }
    }
}
